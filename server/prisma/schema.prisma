generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Fase 0: solo usuarios (John y Lina), login con Google.
// El resto del modelo (months, buckets, transactions, ...) se agrega
// en migraciones posteriores, fase por fase (ver docs/02-modelo-de-datos.md).
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
