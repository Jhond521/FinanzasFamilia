generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Fase 0: solo usuarios (John y Lina), login con Google.
// El resto del modelo (transactions, rules, cards, ...) se agrega
// en migraciones posteriores, fase por fase (ver docs/02-modelo-de-datos.md).
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  incomes               Income[]
  quickEntries          QuickEntry[]  @relation("QuickEntryOwner")
  createdQuickEntries   QuickEntry[]  @relation("QuickEntryCreator")
  transactionsOwned     Transaction[] @relation("TransactionOwner")
  importBatchesOwned    ImportBatch[] @relation("ImportBatchOwner")
  importBatchesUploaded ImportBatch[] @relation("ImportBatchUploader")
  creditCards           CreditCard[]  @relation("CreditCardOwner")
  openingReconciliations OpeningReconciliation[]
  monthClosures         MonthClosure[]

  @@map("users")
}

enum SplitMode {
  proportional
  half
}

enum BucketKind {
  savings
  personal
  shared_expenses
  other
}

enum MonthStatus {
  open
  closed
}

enum QuickEntryType {
  personal
  joint
}

enum QuickEntryStatus {
  pending
  matched
  no_match_expected
}

enum TransactionType {
  personal
  joint
  movement
  unclassified
}

// set_type de Rule y suggested_type de Transaction nunca proponen 'unclassified'
// (es el estado por defecto de una Transaction sin clasificar, no algo que una regla asigne).
enum RuleSetType {
  personal
  joint
  movement
}

enum ClassifiedBy {
  rule
  match
  user
}

enum RuleMode {
  auto
  suggest
}

enum AmountSign {
  any
  positive
  negative
}

enum RuleOrigin {
  seed
  user
  learned
}

enum SkippedDuplicateResolution {
  pending
  confirmed_duplicate
  forced_twin
}

enum ImportBatchStatus {
  done
  undone
}

// Config general de rubros (plantilla). Se instancia como snapshot (MonthBucket)
// al crear un mes; cambiarla no afecta meses ya creados.
model Bucket {
  id         String     @id @default(uuid())
  name       String
  percentage Decimal    @db.Decimal(5, 2)
  splitMode  SplitMode  @map("split_mode")
  kind       BucketKind
  active     Boolean    @default(true)
  sortOrder  Int        @map("sort_order")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  monthBuckets MonthBucket[]

  @@map("buckets")
}

model Month {
  id        String      @id @default(uuid())
  year      Int
  month     Int
  status    MonthStatus @default(open)
  closedAt  DateTime?   @map("closed_at")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  incomes       Income[]
  monthBuckets  MonthBucket[]
  quickEntries  QuickEntry[]
  transactions  Transaction[]
  importBatches ImportBatch[]
  cardMonths    CardMonth[]
  summary       MonthSummary?
  openingReconciliations OpeningReconciliation[]
  monthClosures MonthClosure[]

  @@unique([year, month])
  @@map("months")
}

// Snapshot congelado al cerrar el mes (RF7): mismas cifras que GET /months/:id/summary
// en el momento del cierre (bolsas, ahorro real, dejar en cuenta), para que no se muevan
// si despues cambia la config general de buckets o se edita una transaccion del mes.
model MonthSummary {
  id        String   @id @default(uuid())
  monthId   String   @unique @map("month_id")
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  month Month @relation(fields: [monthId], references: [id], onDelete: Cascade)

  @@map("month_summaries")
}

model Income {
  id        String   @id @default(uuid())
  monthId   String   @map("month_id")
  userId    String   @map("user_id")
  label     String
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  month Month @relation(fields: [monthId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@map("incomes")
}

// Snapshot editable del rubro dentro de un mes; se copia de Bucket al crear
// el mes y se congela al cerrarlo. bucketId nulo = rubro agregado solo ese mes.
model MonthBucket {
  id         String     @id @default(uuid())
  monthId    String     @map("month_id")
  bucketId   String?    @map("bucket_id")
  name       String
  percentage Decimal    @db.Decimal(5, 2)
  splitMode  SplitMode  @map("split_mode")
  kind       BucketKind
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  month  Month   @relation(fields: [monthId], references: [id], onDelete: Cascade)
  bucket Bucket? @relation(fields: [bucketId], references: [id])

  @@unique([monthId, bucketId])
  @@map("month_buckets")
}

// Registro rapido de gasto (reemplaza WhatsApp, Fase 2). userId = de quien es el
// gasto (para el reparto por bolsa); createdBy = quien lo registro (puede ser el otro).
// matchedTransactionId (FK a una futura tabla transactions) se agrega en Fase 3 -
// ese modelo todavia no existe.
model QuickEntry {
  id                   String           @id @default(uuid())
  monthId              String           @map("month_id")
  userId               String           @map("user_id")
  createdBy            String           @map("created_by")
  amount               Decimal          @db.Decimal(14, 2)
  description          String
  type                 QuickEntryType
  date                 DateTime         @db.Date
  status               QuickEntryStatus @default(pending)
  matchedTransactionId String?          @unique @map("matched_transaction_id")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  month              Month        @relation(fields: [monthId], references: [id], onDelete: Cascade)
  user               User         @relation("QuickEntryOwner", fields: [userId], references: [id])
  creator            User         @relation("QuickEntryCreator", fields: [createdBy], references: [id])
  matchedTransaction Transaction? @relation("QuickEntryMatch", fields: [matchedTransactionId], references: [id])

  @@index([monthId, status])
  @@map("quick_entries")
}

// ---- Fase 3: importacion + clasificacion (docs/02-modelo-de-datos.md) ----

model Category {
  id        String   @id @default(uuid())
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rulesAsSetCategory    Rule[]        @relation("RuleSetCategory")
  transactions          Transaction[] @relation("TransactionCategory")
  suggestedTransactions Transaction[] @relation("TransactionSuggestedCategory")

  @@map("categories")
}

// Motor de clasificacion determinístico (RF5). match_field queda fijo en "bank_description"
// hoy (unico campo soportado); se deja como columna por si a futuro se agregan mas.
model Rule {
  id            String      @id @default(uuid())
  pattern       String
  matchField    String      @default("bank_description") @map("match_field")
  amountSign    AmountSign  @default(any) @map("amount_sign")
  setType       RuleSetType @map("set_type")
  setCategoryId String?     @map("set_category_id")
  setDetail     String?     @map("set_detail")
  mode          RuleMode
  active        Boolean     @default(true)
  hitCount      Int         @default(0) @map("hit_count")
  createdFrom   RuleOrigin  @map("created_from")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  setCategory  Category?     @relation("RuleSetCategory", fields: [setCategoryId], references: [id])
  transactions Transaction[]

  @@map("rules")
}

model ImportBatch {
  id             String            @id @default(uuid())
  monthId        String            @map("month_id")
  ownerUserId    String            @map("owner_user_id")
  filename       String
  uploadedBy     String            @map("uploaded_by")
  rowCount       Int               @map("row_count")
  importedCount  Int               @map("imported_count")
  duplicateCount Int               @map("duplicate_count")
  status         ImportBatchStatus @default(done)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  month             Month              @relation(fields: [monthId], references: [id], onDelete: Cascade)
  owner             User               @relation("ImportBatchOwner", fields: [ownerUserId], references: [id])
  uploader          User               @relation("ImportBatchUploader", fields: [uploadedBy], references: [id])
  transactions      Transaction[]
  skippedDuplicates SkippedDuplicate[]

  @@map("import_batches")
}

// Filas del archivo detectadas como duplicado de algo ya en BD (mismo mes+dueño), guardadas
// para la pantalla de revision en vez de descartarse directo (docs/02, seccion Deduplicacion).
model SkippedDuplicate {
  id                  String                     @id @default(uuid())
  importBatchId       String                     @map("import_batch_id")
  dedupeKey           String                     @map("dedupe_key")
  date                DateTime                   @db.Date
  bankDescription     String                     @map("bank_description")
  bankReference       String?                    @map("bank_reference")
  amount              Decimal                    @db.Decimal(14, 2)
  resolution          SkippedDuplicateResolution @default(pending)
  forcedTransactionId String?                    @unique @map("forced_transaction_id")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  importBatch       ImportBatch  @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  forcedTransaction Transaction? @relation("ForcedTwin", fields: [forcedTransactionId], references: [id])

  @@map("skipped_duplicates")
}

model Transaction {
  id                  String           @id @default(uuid())
  monthId             String           @map("month_id")
  ownerUserId         String           @map("owner_user_id")
  importBatchId       String           @map("import_batch_id")
  date                DateTime         @db.Date
  bankDescription     String           @map("bank_description")
  bankReference       String?          @map("bank_reference")
  amount              Decimal          @db.Decimal(14, 2)
  type                TransactionType  @default(unclassified)
  categoryId          String?          @map("category_id")
  detail              String?
  classifiedBy        ClassifiedBy?    @map("classified_by")
  ruleId              String?          @map("rule_id")
  dedupeKey           String           @map("dedupe_key")
  needsReview         Boolean          @default(true) @map("needs_review")
  suggestedType       TransactionType? @map("suggested_type")
  suggestedCategoryId String?          @map("suggested_category_id")
  suggestedDetail     String?          @map("suggested_detail")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  month                      Month             @relation(fields: [monthId], references: [id], onDelete: Cascade)
  owner                      User              @relation("TransactionOwner", fields: [ownerUserId], references: [id])
  importBatch                ImportBatch       @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  category                   Category?         @relation("TransactionCategory", fields: [categoryId], references: [id])
  suggestedCategory          Category?         @relation("TransactionSuggestedCategory", fields: [suggestedCategoryId], references: [id])
  rule                       Rule?             @relation(fields: [ruleId], references: [id])
  matchedQuickEntry          QuickEntry?       @relation("QuickEntryMatch")
  forcedFromSkippedDuplicate SkippedDuplicate? @relation("ForcedTwin")

  @@index([monthId, dedupeKey])
  @@map("transactions")
}

// ---- Fase 4: tarjetas de credito Nu Bank (docs/02-modelo-de-datos.md) ----
// Modulo independiente: no participa de bolsas, dashboard ni cierre de mes (RF6).

model CreditCard {
  id          String   @id @default(uuid())
  name        String
  ownerUserId String   @map("owner_user_id")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner      User        @relation("CreditCardOwner", fields: [ownerUserId], references: [id])
  cardMonths CardMonth[]

  @@map("credit_cards")
}

// Ciclo mensual de una tarjeta. Se crea "get-or-create" (amount_paid=0) la primera vez que se
// pide para un (tarjeta, mes) — no hay un POST explicito en docs/03-api.md.
model CardMonth {
  id           String   @id @default(uuid())
  creditCardId String   @map("credit_card_id")
  monthId      String   @map("month_id")
  amountPaid   Decimal  @default(0) @map("amount_paid") @db.Decimal(14, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  creditCard CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  month      Month      @relation(fields: [monthId], references: [id], onDelete: Cascade)
  items      CardItem[]

  @@unique([creditCardId, monthId])
  @@map("card_months")
}

// Compra itemizada de la tarjeta. amount admite negativos (devoluciones, cancelaciones o
// ajustes que restan — docs/02 originalmente lo documentaba siempre positivo, ajustado a
// pedido del producto); type reusa el enum de QuickEntry (personal|joint) — mismo
// significado, no hace falta un enum propio.
model CardItem {
  id           String         @id @default(uuid())
  cardMonthId  String         @map("card_month_id")
  description  String
  date         DateTime?      @db.Date
  amount       Decimal        @db.Decimal(14, 2)
  type         QuickEntryType
  isAdjustment Boolean        @default(false) @map("is_adjustment")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  cardMonth CardMonth @relation(fields: [cardMonthId], references: [id], onDelete: Cascade)

  @@map("card_items")
}

// ---- Cuadre de Inicio (ticket #29) ----
// Historial de intentos de cuadre de apertura de mes por persona: guarda el saldo confirmado
// tras la transferencia y las cifras calculadas en ese momento, para poder mostrar "realizado
// en [fecha]" y permitir rehacerlo sin perder los intentos anteriores (igual que import_batches).
model OpeningReconciliation {
  id              String   @id @default(uuid())
  monthId         String   @map("month_id")
  userId          String   @map("user_id")
  accountBalance  Decimal  @map("account_balance") @db.Decimal(14, 2)
  expensesToDate  Decimal  @map("expenses_to_date") @db.Decimal(14, 2)
  leaveInAccount  Decimal  @map("leave_in_account") @db.Decimal(14, 2)
  moveToSavings   Decimal  @map("move_to_savings") @db.Decimal(14, 2)
  matched         Boolean
  createdAt       DateTime @default(now()) @map("created_at")

  month Month @relation(fields: [monthId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([monthId, userId, createdAt])
  @@map("opening_reconciliations")
}

enum MonthClosureActionType {
  closed
  reopened
}

// ---- Cierre de mes individual por persona (ticket #34) ----
// Historial de eventos de cierre/reapertura por persona y mes -- nunca se borra (igual que
// opening_reconciliations); el estado actual de una persona es el ultimo evento. El mes se
// congela de verdad (Month.status='closed', month_summaries) solo cuando ambas personas estan
// en estado 'closed' -- ver computeBothClosed en months.ts.
model MonthClosure {
  id        String                  @id @default(uuid())
  monthId   String                  @map("month_id")
  userId    String                  @map("user_id")
  action    MonthClosureActionType
  createdAt DateTime                @default(now()) @map("created_at")

  month Month @relation(fields: [monthId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([monthId, userId, createdAt])
  @@map("month_closures")
}
