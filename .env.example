# Postgres (local: docker compose up db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finanzas_pareja

# Sesion (cookie httpOnly, la sesion vive en Postgres via connect-pg-simple)
SESSION_SECRET=changeme

# Google OAuth 2.0 (credenciales separadas por ambiente en Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Whitelist de acceso
ALLOWED_EMAILS=jhond5@gmail.com,lina.tic.isc@gmail.com

# Google Sheets API (ticket ##51 -- boton "Actualizar Sheet" en /transacciones).
# Service account propio (no reusa las credenciales de login de arriba). El Sheet real debe
# compartirse manualmente (acceso Editor) con el email de esta cuenta de servicio desde Drive.
# Mismo Sheet en dev y prod: los tabs que genera dev llevan el prefijo "DEV_" para no mezclarse
# con los tabs reales -- ver GOOGLE_SHEETS_TAB_PREFIX.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_TAB_PREFIX=DEV_

# URL publica de la app (a donde redirige tras login)
APP_URL=http://localhost:5173

PORT=3000
NODE_ENV=development
